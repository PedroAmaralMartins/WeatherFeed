<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/weather_background_deep">


    <TextView
        android:id="@+id/tv_section_label"
        style="@style/WeatherText.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preferences"
        android:layout_marginTop="@dimen/weather_radius_md"
        android:layout_marginStart="@dimen/weather_radius_md"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_screen_title"
        style="@style/WeatherText.ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/weather_radius_sm"
        android:layout_marginStart="@dimen/weather_radius_md"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_section_label" />

    <com.weather.designsystem.xml.WeatherSettingsRowView
        android:id="@+id/row_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/weather_radius_md"
        android:layout_marginHorizontal="@dimen/weather_radius_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_screen_title" />

</androidx.constraintlayout.widget.ConstraintLayout>